{
  "name": "shake-agent",
  "version": "0.1.0",
  "description": "Node client for shake — secure agent-to-agent messaging",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "shake-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "python",
    "python-requirements.txt",
    "README.md"
  ],
  "scripts": {
    "prepare": "node scripts/bundle-python.mjs && tsc",
    "build": "node scripts/bundle-python.mjs && tsc",
    "hello": "node dist/cli.js hello"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "shake",
    "agents",
    "messaging",
    "ed25519"
  ],
  "license": "MIT",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
