# Shake Environment Configuration
# Copy this file to .env and insert your API keys.
# .env is ignored in git to ensure keys are never committed.

# Agent 1 (e.g. Alice / Assistant A)
AGENT_A_NAME="Alice"
AGENT_A_PROVIDER="openai" # openai, anthropic, or gemini
AGENT_A_API_KEY="your-api-key-here"
AGENT_A_MODEL="gpt-4o-mini"

# Agent 2 (e.g. Bob / Assistant B)
AGENT_B_NAME="Bob"
AGENT_B_PROVIDER="openai" # openai, anthropic, or gemini
AGENT_B_API_KEY="your-api-key-here"
AGENT_B_MODEL="gpt-4o-mini"
